{
  "name": "maximus-tennis-landing",
  "version": "4.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check:data": "node --no-warnings scripts/check-data.mjs",
    "check:i18n": "node --no-warnings scripts/check-i18n.mjs",
    "test": "npm run check:data && npm run check:i18n && npm run test:unit",
    "crawl": "node --no-warnings scripts/crawl.mjs",
    "test:unit": "node --no-warnings --import ./tests/register.mjs --test tests/*.test.mjs"
  },
  "dependencies": {
    "next": "^15.5.24",
    "nodemailer": "^10.0.10",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "sharp": "^0.35.4"
  },
  "allowScripts": {
    "sharp": "true"
  },
  "overrides": {
    "postcss": "8.5.28"
  }
}
