# Request intake — set these in Vercel (Project → Settings → Environment Variables). Never commit real values.
# Durable store (Vercel Marketplace → Upstash for Redis creates the first two automatically)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Notification e-mail (Google Workspace: smtp.gmail.com, 465, app password of the sending mailbox)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
LEAD_NOTIFY_TO=gps@maximus.tennis
LEAD_NOTIFY_FROM=
# Alternative notification channel (HTTPS webhook, HMAC-signed)
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=
# LEAD_NOTIFY_CHANNEL=smtp
# Scheduled retry (≥ 16 characters) and private register password (≥ 12 characters)
CRON_SECRET=
LEADS_ADMIN_PASSWORD=
# Optional
RATE_LIMIT_SALT=
LEADS_RATE_LIMIT=10
LEADS_RATE_WINDOW_SECONDS=600
NEXT_PUBLIC_GA_MEASUREMENT_ID=
